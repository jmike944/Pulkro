# Copy to .env.local. Both values are public (browser) values from Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# "0" builds the pilot/production app without the demo data and the demo role switcher.
# NEXT_PUBLIC_DEMO=0
